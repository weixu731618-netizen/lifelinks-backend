# 复制为 .env 后填写，切勿提交到 Git（.env 已在 .gitignore 中）。

# App 与后端之间的共享令牌（不是 DeepSeek 的 Key），App 内「我的-AI设置」需填写相同值。
APP_SHARED_TOKEN=change-me

# DeepSeek 的 API Key，只保存在服务端。在 https://platform.deepseek.com 申请。
DEEPSEEK_API_KEY=

# 一般不需要改。deepseek-flash 是官方当前最新版本（V4.1-Flash）；deepseek-v4-pro 参数更大但是推理模型，
# 会先消耗大量 token 做内部思考，需要更高的 max_tokens 预算。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

REQUEST_TIMEOUT_SECONDS=30
