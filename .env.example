# 复制为 .env 后填写，切勿提交到 Git（.env 已在 .gitignore 中）。

# App 与后端之间 session token 的签名密钥（不是 DeepSeek 的 Key），必须设置为一个随机长字符串，
# 例如用 `python3 -c "import secrets; print(secrets.token_hex(32))"` 生成。
SESSION_JWT_SECRET=change-me

# 必须和 Xcode 工程里 PRODUCT_BUNDLE_IDENTIFIER（project.yml）一致，用于校验 Apple identity token
# 的 aud 字段，防止别的 App 签发的 token 被拿来登录本服务。
APPLE_BUNDLE_ID=com.weixu.lifelinks2.app

# DeepSeek 的 API Key，只保存在服务端。在 https://platform.deepseek.com 申请。
DEEPSEEK_API_KEY=

# 一般不需要改。deepseek-flash 是官方当前最新版本（V4.1-Flash）；deepseek-v4-pro 参数更大但是推理模型，
# 会先消耗大量 token 做内部思考，需要更高的 max_tokens 预算。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

REQUEST_TIMEOUT_SECONDS=30
